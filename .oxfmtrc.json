{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "dist",
    "node_modules",
    "drizzle",
    ".wrangler",
    "worker-configuration.d.ts"
  ]
}
