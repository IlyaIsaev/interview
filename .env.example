# Better Auth (also set in .dev.vars for local Wrangler)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Used by drizzle-kit (push / migrate / studio) via the D1 HTTP API.
# Get these from the Cloudflare dashboard or API tokens page.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
